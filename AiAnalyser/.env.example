# ─────────────────────────────────────────────────────────────────────────────
# AI Analyser — copy to `.env` and fill in at least one provider key.
# ─────────────────────────────────────────────────────────────────────────────

# Providers (the router skips any provider whose key is empty)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Service
HOST=0.0.0.0
PORT=8000
# Optional shared secret. When set, callers must send X-Service-Token.
SERVICE_TOKEN=

# Limits
MAX_FILE_MB=5
MAX_INPUT_CHARS=40000
MAX_REPAIR_ATTEMPTS=2
LLM_MAX_RETRIES=1
