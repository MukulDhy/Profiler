<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your ProfileGPT email</title>
  </head>
  <body style="margin:0;padding:0;background:#0c0c0d;font-family:Arial,Helvetica,sans-serif;color:#f5f5f4;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#0c0c0d;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#151516;border:1px solid #2a2a2c;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="padding:28px 32px;border-bottom:1px solid #2a2a2c;">
                <div style="font-size:18px;font-weight:700;letter-spacing:-0.02em;">ProfileGPT</div>
                <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#a3e635;margin-top:6px;">Neural Interface</div>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 16px;font-size:24px;letter-spacing:-0.02em;">Verify your email</h1>
                <p style="margin:0 0 20px;font-size:14px;line-height:1.7;color:#a1a1aa;">Hi <%= user.name %>,</p>
                <p style="margin:0 0 24px;font-size:14px;line-height:1.7;color:#a1a1aa;">
                  Use the code below to verify your ProfileGPT account. It expires in 10 minutes.
                </p>
                <div style="font-size:34px;font-weight:700;letter-spacing:0.35em;color:#a3e635;background:#0c0c0d;border:1px solid #2a2a2c;border-radius:12px;padding:18px;text-align:center;">
                  <%= otp %>
                </div>
                <p style="margin:24px 0 0;font-size:12px;line-height:1.7;color:#71717a;">
                  If you did not create this account, you can safely ignore this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;border-top:1px solid #2a2a2c;font-size:11px;color:#52525b;">
                ProfileGPT · Your resume can finally talk.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
