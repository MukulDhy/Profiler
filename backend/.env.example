# ------------------------------------------------------------------------------
# Backend — copy to `.env` and adjust for your machine.
# ------------------------------------------------------------------------------

NODE_ENV=development
PORT=5001
HOST=0.0.0.0
CLIENT_URL=http://localhost:8080

MONGO_URI=mongodb://127.0.0.1:27017/profilegpt
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=20

# Cloudinary (resume files + avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (verification codes, password resets, welcome email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=

# Google sign-in — create an OAuth Web client and paste its client id here.
# The matching frontend value is VITE_GOOGLE_CLIENT_ID. Leave blank to hide the
# Google button.
GOOGLE_CLIENT_ID=

# Require a verified email before protected routes are served.
REQUIRE_EMAIL_VERIFICATION=false

# AI Analyser (Python / LangGraph service)
AI_ANALYSER_URL=http://localhost:8000
AI_ANALYSER_TIMEOUT=450000
# Optional; must match SERVICE_TOKEN in AiAnalyser/.env
AI_SERVICE_TOKEN=

# GitHub activity — optional token raises the public API rate limit.
GITHUB_TOKEN=

# Local demo auth: use a shared demo account when no JWT is supplied.
# Set to false in production.
DEMO_MODE=true

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
